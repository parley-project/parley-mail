<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-mail</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>Parley Mail</name>
	<description>Internet mail messages (RFC 5322, MIME, RFC 2047/2231 and RFC 6532 UTF-8 headers,
		RFC 6858 downgrading) and the mailbox store shared by the Parley SMTP, IMAP and POP3
		servers. Messages and mailboxes live in a parley-files FileSource, so messages can be
		larger than memory. Split out of us.bringardner:bjl_email.</description>
	<inceptionYear>2026</inceptionYear>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.mail</parley.moduleName>
		<junit.version>5.11.4</junit.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<!-- Small heap on purpose: TestLargeMessage handles a 150 MB attachment,
						     which only passes if Message keeps bodies out of memory. -->
						<argLine>-Xmx64m</argLine>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<!-- GitHub Packages, used by release.sh. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/parley-mail</url>
		</repository>
	</distributionManagement>

	<dependencies>
		<!-- Messages and mailboxes are stored in a FileSource; brings in parley-core and parley-io -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
